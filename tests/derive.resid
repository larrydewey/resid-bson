// derive.resid — instances generated by resid-derive, run over CBOR. The
// point is not the derive itself (resid-serial tests that) but that the
// generated code needs nothing from a format beyond the protocol, so the
// same instances work here.

import "../src/bson.resid";
import "model_serial.resid";
import "check.resid";

Str cfg_text(Config c) { Result(Str, SerialError) r = to_bson_hex(c); return hex_text_of(r); }

Str config_err(Result(Config, SerialError) r) {
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(c) = r) { return f"{c.host_name}/{c.login_count}"; }
    return "unreachable";
}

Str config_text(Str hex) {
    Result(Config, SerialError) r = from_bson_hex(hex);
    return config_err(r);
}

Str event_text(Str hex) {
    Result(Event, SerialError) r = from_bson_hex(hex);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(ev) = r) { return show_event(ev); }
    return "unreachable";
}

Str show_event(Event ev) {
    Event e = ev;
    return match e {
        Started(c) => f"Started({c.host_name})",
        Stopped => "Stopped"
    };
}

Str meters_text(Str hex) {
    Result(Meters, SerialError) r = from_bson_hex(hex);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(m) = r) { return f"{m.value}"; }
    return "unreachable";
}

Str loose_text(Str hex) {
    Result(Loose, SerialError) r = from_bson_hex(hex);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(l) = r) { return match l { Num(n) => f"Num({n})", Word(s) => f"Word({s})", Nothing => "Nothing" }; }
    return "unreachable";
}

Int main() {
    Option(Str) some_mail = Some("a@b");
    Config c = Config {.host_name = "example.com", .login_count = 3, .email = some_mail, .secret = "hunter2"};

    // rename_all camelCase, rename, skip, and the field order as written.
    // Written as the document BSON makes of a record: the fields in order,
    // each an element named by its field name.
    check_text("config/hex", cfg_text(c), "3e00000002686f73746e616d65000c0000006578616d706c652e636f6d00106c6f67696e436f756e74000300000002656d61696c00040000006140620000");

    // Round trip, and the alias on decode.
    check_text("config/back", config_text(cfg_text(c)), "example.com/3");
    check_text("config/alias", config_text("3c00000002736572766572000c0000006578616d706c652e636f6d00106c6f67696e436f756e74000300000002656d61696c00040000006140620000"), "example.com/3");

    // An absent Option field decodes as None; a default fills in.
    check_text("config/minimal", config_text("2f00000002686f73746e616d65000c0000006578616d706c652e636f6d00106c6f67696e436f756e74000000000000"), "example.com/0");

    // skip_encoding_if drops the field entirely.
    Option(Str) no_mail = None;
    Config bare = Config {.host_name = "h", .login_count = 1, .email = no_mail, .secret = "s"};
    check_text("config/skipped", cfg_text(bare), "2500000002686f73746e616d6500020000006800106c6f67696e436f756e74000100000000");

    // deny_unknown_fields.
    Result(Config, SerialError) unknown = from_bson_hex("3c00000002686f73746e616d65000c0000006578616d706c652e636f6d00106c6f67696e436f756e740003000000027a7a7a00040000006140620000");
    check_text("config/deny unknown", config_err(unknown), "decode: unknown field `zzz`, expected `hostname`, `server`, `loginCount` or `email`");

    // An internally tagged enum: a document with "kind" in it, the variant
    // names in snake_case.
    check_text("event/started", hex_text_of(to_bson_hex(Started(bare))), "37000000026b696e640008000000737461727465640002686f73746e616d6500020000006800106c6f67696e436f756e74000100000000");
    check_text("event/stopped", hex_text_of(to_bson_hex(Stopped)), "17000000026b696e64000800000073746f707065640000");
    check_text("event/back", event_text("37000000026b696e640008000000737461727465640002686f73746e616d6500020000006800106c6f67696e436f756e74000100000000"), "Started(h)");
    check_text("event/unit back", event_text("17000000026b696e64000800000073746f707065640000"), "Stopped");
    check_text("event/unknown kind", event_text("14000000026b696e640005000000636f6f700000"), "decode: unknown variant `coop`, expected `started` or `stopped`");

    // transparent: the one field, with no wrapper around it.
    check_text("meters", hex_text_of(to_bson_hex(Meters {.value = 1.5})), "01000000000000f83f");
    check_text("meters/back", meters_text("01000000000000f83f"), "1.5");

    // untagged: the payload alone, tried in order.
    check_text("loose/num", loose_text("1005000000"), "Num(5)");
    check_text("loose/word", loose_text("0205000000776f726400"), "Word(word)");
    check_text("loose/nothing", loose_text("0a"), "Nothing");
    check_text("loose/ambiguous", loose_text("1005000000"), "Num(5)");

    return 0;
}